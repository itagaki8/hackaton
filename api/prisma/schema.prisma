generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Issue {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  repo      String
  number    Int
  title     String
  labels    String
  analysis  String
  status    String   @default("TODO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}